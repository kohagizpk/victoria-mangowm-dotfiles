{
  "wallpaper_path": "~/Pictures/Wallpapers/",
  "cache_path": "~/.cache/victoria/wallpaper-thumbs/",
  "active_layout": "layouts/shell-floating-clean.qml",
  "wallpaper_tool": "awww",
  "custom_command": "awww img ${VICTORIA_WALLPAPER_OUTPUT:+--outputs \"$VICTORIA_WALLPAPER_OUTPUT\"} \"$WALLPAPER\" --transition-type grow --transition-duration 1 --transition-fps 60",
  "post_apply": [
    "bash \"$HOME/.config/mango/scripts/wallust-reload.sh\" \"$WALLPAPER_STILL\""
  ],
  "notify_on_apply": false,
  "number_of_pictures": 7,
  "border_color": "#FF716D",
  "cache_batch_size": 8,
  "stable_copy_path": "",
  "video_extensions": [
    "mp4",
    "webm",
    "mov",
    "mkv",
    "gif"
  ],
  "video_thumbnail_interval": 5
}
